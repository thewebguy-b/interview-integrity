{
  "name": "interview-integrity",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/interviewer-dashboard",
    "apps/candidate-agent"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:dashboard": "npm run dev --workspace=apps/interviewer-dashboard",
    "dev:agent": "npm run dev --workspace=apps/candidate-agent",
