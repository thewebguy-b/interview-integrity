{
  "name": "candidate-agent",
  "version": "0.1.0",
  "description": "Interview Integrity Candidate Companion Agent",
  "author": "Interview Integrity Team",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && electron dist/main.js",
    "build": "tsc",
    "dist": "tsc && electron-builder --win portable",
    "start": "electron dist/main.js"
  },
  "build": {
    "appId": "com.interviewintegrity.agent",
    "productName": "Interview-Integrity-Agent",
    "electronVersion": "31.2.0",
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*"
    ],
    "win": {
      "target": "portable",
      "artifactName": "Interview-Integrity-Agent.exe"
    }
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "electron": "31.2.0",
    "typescript": "^5.5.3",
    "@types/node": "^20.14.10"
  }
}
